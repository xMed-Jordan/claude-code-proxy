[Unit]
Description=connect-face-api - face embedding sidecar (insightface buffalo_l) for connect-ai-proxy
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/faceapi
ExecStart=/opt/faceapi/venv/bin/python /opt/faceapi/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
