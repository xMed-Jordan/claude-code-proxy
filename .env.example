UPSTREAM=codex
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
CODEX_AUTH_FILE=C:\Users\you\.codex\auth.json
# OPENAI_API_KEY is only used when UPSTREAM=openai.
OPENAI_API_KEY=sk-or-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CLAUDE_SONNET_MODEL=gpt-5.5
OPENAI_CLAUDE_SONNET_1M_MODEL=gpt-5.5
OPENAI_CLAUDE_HAIKU_MODEL=gpt-5.4-mini
OPENAI_CLAUDE_OPUS_MODEL=gpt-5.5
OPENAI_CLAUDE_OPUS_1M_MODEL=gpt-5.5
OPENAI_CLAUDE_FAST_MODEL=gpt-5.5
OPENAI_CLAUDE_CODEX_MODEL=gpt-5.3-codex
CODEX_FAST_SERVICE_TIER=priority
CODEX_WEB_SEARCH_TOOL_TYPE=web_search
CODEX_REASONING_SUMMARY=auto
CODEX_SESSION_ISOLATION=1
CODEX_SESSION_FILE=.proxy.sessions.json
CODEX_PROMPT_CACHE_KEY=1
CLAUDE_TOOL_ACTIVITY_THINKING=1
# Optional Antigravity/Chrome bridge overrides. Defaults are auto-discovered.
# ANTIGRAVITY_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# ANTIGRAVITY_EXTENSION_PATH=C:\Users\you\AppData\Local\Google\Chrome\User Data\Default\Extensions\eeijfnjmjelapkebgockoeaadonbchdd\1.11.3_0
# ANTIGRAVITY_BROWSER_PROFILE=C:\Users\you\Documents\claude-code-proxy\.antigravity-browser-profile
# Use "default" to attach only if Chrome already exposes a DevTools endpoint.
# Modern Chrome blocks launching DevTools control on the normal Default profile,
# so the bridge falls back to a controlled profile for visible Claude Code actions.
# Use "dedicated" to always launch the controlled profile.
ANTIGRAVITY_BROWSER_MODE=default
ANTIGRAVITY_BROWSER_PRELAUNCH_WITH_PROXY=0
ANTIGRAVITY_BROWSER_DEBUG_PORT=9233
# Optional: override where browser_screenshot saves PNG files.
# By default it uses "<Claude Code launch directory>\Claude Code Screenshots".
# ANTIGRAVITY_SCREENSHOT_DIR=C:\Users\you\Pictures\Claude Code Screenshots
# Only for older/custom Chrome builds where Default-profile DevTools still works.
ANTIGRAVITY_BROWSER_FORCE_DEFAULT_CDP=0
# When forced Default CDP is enabled and Chrome is only background/proxy windows,
# this permits a safe relaunch with the DevTools port.
ANTIGRAVITY_BROWSER_SAFE_DEFAULT_RELAUNCH=1
# Optional: low, medium, or high if your Codex backend accepts it.
# CODEX_WEB_SEARCH_CONTEXT_SIZE=medium
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-7[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES=effort,xhigh_effort,max_effort,thinking,adaptive_thinking,interleaved_thinking
ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES=effort,max_effort,thinking,adaptive_thinking,interleaved_thinking
ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES=thinking
CLAUDE_CODE_EFFORT_LEVEL=xhigh
OPENAI_REASONING_EFFORT=xhigh
API_TIMEOUT_MS=3000000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
PROXY_API_KEY=sk-local-proxy-token
PROXY_PORT=4000
