# UPSTREAM can be: codex, antigravity, or openai
UPSTREAM=codex
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
# Optional. Defaults to ~/.codex/auth.json on Windows, Linux, and macOS.
CODEX_AUTH_FILE=
# OPENAI_API_KEY is only used when UPSTREAM=openai.
OPENAI_API_KEY=sk-or-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CLAUDE_SONNET_MODEL=gpt-5.5
OPENAI_CLAUDE_SONNET_1M_MODEL=gpt-5.5
OPENAI_CLAUDE_HAIKU_MODEL=gpt-5.4-mini
OPENAI_CLAUDE_OPUS_MODEL=gpt-5.5
OPENAI_CLAUDE_OPUS_1M_MODEL=gpt-5.5
OPENAI_CLAUDE_FAST_MODEL=gpt-5.5
# Gemini/Antigravity API key to route requests when UPSTREAM=antigravity or using Antigravity models.
# Falls back to standard Authorization header or GEMINI_API_KEY env.
ANTIGRAVITY_API_KEY=
ANTIGRAVITY_GATEWAY_PORT=4005
OPENAI_CLAUDE_CODEX_MODEL=gpt-5.3-codex
# UI-managed custom model alias overrides. Leave empty unless edited in Models.
PROXY_MODEL_ALIASES=
PROXY_MODEL_ALIASES_DISABLED=
CODEX_FAST_SERVICE_TIER=priority
CODEX_WEB_SEARCH_TOOL_TYPE=web_search
CODEX_REASONING_SUMMARY=auto
CODEX_SESSION_ISOLATION=1
CODEX_SESSION_FILE=.proxy.sessions.json
CODEX_PROMPT_CACHE_KEY=1
# Codex routes advertise a 200,000-token active context window so Claude Code
# compacts before hidden tool/subagent payloads reach the live backend.
# The proxy does not return assistant-message recovery text.
CODEX_UPSTREAM_HARD_TOKENS=200000
CODEX_UPSTREAM_BLOCK_AT_HARD=0
CLAUDE_TOOL_ACTIVITY_THINKING=1
# Optional Antigravity/Chrome bridge overrides. Defaults are auto-discovered.
# Set to 0 on servers or installs that should not add browser MCP tools.
ANTIGRAVITY_BROWSER_ENABLED=1
# ANTIGRAVITY_CHROME_PATH=/path/to/google-chrome-or-chrome.exe
# ANTIGRAVITY_EXTENSION_PATH=/path/to/Chrome/User Data/Default/Extensions/eeijfnjmjelapkebgockoeaadonbchdd/1.11.3_0
# ANTIGRAVITY_BROWSER_PROFILE=.antigravity-browser-profile
# Use "default" to attach only if Chrome already exposes a DevTools endpoint.
# Modern Chrome blocks launching DevTools control on the normal Default profile,
# so the bridge falls back to a controlled profile for visible Claude Code actions.
# Use "dedicated" to always launch the controlled profile. This is the
# recommended local-browser mode because it does not take over your normal tabs.
ANTIGRAVITY_BROWSER_MODE=dedicated
ANTIGRAVITY_BROWSER_PRELAUNCH_WITH_PROXY=0
ANTIGRAVITY_BROWSER_DEBUG_PORT=9233
# Optional: override where browser_screenshot saves PNG files.
# By default it uses "<Claude Code launch directory>\Claude Code Screenshots".
# ANTIGRAVITY_SCREENSHOT_DIR=/path/to/Claude Code Screenshots
# Only for older/custom Chrome builds where Default-profile DevTools still works.
ANTIGRAVITY_BROWSER_FORCE_DEFAULT_CDP=0
# When forced Default CDP is enabled and Chrome is only background/proxy windows,
# this permits a safe relaunch with the DevTools port.
ANTIGRAVITY_BROWSER_SAFE_DEFAULT_RELAUNCH=1
# Optional: low, medium, or high if your Codex backend accepts it.
# CODEX_WEB_SEARCH_CONTEXT_SIZE=medium
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-7[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES=effort,xhigh_effort,max_effort,thinking,adaptive_thinking,interleaved_thinking
ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES=effort,max_effort,thinking,adaptive_thinking,interleaved_thinking
ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES=thinking
CLAUDE_CODE_EFFORT_LEVEL=xhigh
OPENAI_REASONING_EFFORT=xhigh
API_TIMEOUT_MS=3000000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
PROXY_API_KEY=sk-local-proxy-token
PROXY_HOST=127.0.0.1
PROXY_PORT=4000
# Optional public HTTPS/domain URL shown to clients and API docs. Leave blank for local-only installs.
# Standard ports are omitted, for example https://proxy.example.com instead of https://proxy.example.com:443.
PROXY_PUBLIC_URL=
PROXY_DB_PATH=.proxy.db
PROXY_AUTO_UPDATE=0
PROXY_UPDATE_REPO_DIR=
PROXY_UPDATE_BRANCH=main
PROXY_UPDATE_VERSION_URL=https://raw.githubusercontent.com/xMed-Jordan/claude-code-proxy/main/VERSION
PROXY_UPDATE_STATUS_FILE=.proxy.update.json
PROXY_DASHBOARD_FULL_SYSTEM_UPDATE=1
# Admin panel login. Leave ADMIN_PASSWORD_HASH empty to use the first-run setup screen.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Local client base URLs after startup:
# Anthropic-compatible: http://127.0.0.1:${PROXY_PORT}/anthropic
# OpenAI-compatible: http://127.0.0.1:${PROXY_PORT}/openai/v1
# Server HTTPS installs show PROXY_PUBLIC_URL in the dashboard, docs, OpenAPI, and Postman exports.
# Optional custom session headers accepted by both schemas:
# X-Proxy-Session-Id, X-Codex-Session-Id, X-OpenAI-Session-Id, X-Session-Id
