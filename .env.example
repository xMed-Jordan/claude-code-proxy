# UPSTREAM can be: codex or openai
UPSTREAM=codex
# Per-upstream kill switches (also in the control panel → Configuration → Upstream
# services). Set to 0 to make the proxy refuse that backend entirely (a request
# routed to it returns a clear "<name> upstream is disabled" error). Apply on restart.
PROXY_CODEX_ENABLED=1
PROXY_CLAUDE_ENABLED=1
PROXY_AGY_ENABLED=1
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
# Optional. Defaults to ~/.codex/auth.json on Windows, Linux, and macOS.
CODEX_AUTH_FILE=
# Codex CLI version advertised to ChatGPT. Newer models (e.g. gpt-5.6-terra) are
# gated on it; bump if upstream says "requires a newer version of Codex".
PROXY_CODEX_VERSION=0.144.1
# OPENAI_API_KEY is only used when UPSTREAM=openai.
OPENAI_API_KEY=sk-or-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CLAUDE_SONNET_MODEL=gpt-5.5
OPENAI_CLAUDE_SONNET_1M_MODEL=gpt-5.5
OPENAI_CLAUDE_HAIKU_MODEL=gpt-5.4-mini
OPENAI_CLAUDE_OPUS_MODEL=gpt-5.5
OPENAI_CLAUDE_OPUS_1M_MODEL=gpt-5.5
OPENAI_CLAUDE_FAST_MODEL=gpt-5.5
OPENAI_CLAUDE_CODEX_MODEL=gpt-5.3-codex
# UI-managed custom model alias overrides. Leave empty unless edited in Models.
PROXY_MODEL_ALIASES=
PROXY_MODEL_ALIASES_DISABLED=
# Claude (Anthropic) upstream — used when a model's "Forwarded to" = Claude.
# Serves the alias from the local Claude Code CLI (`claude -p`) backed by a
# Claude Max/Pro subscription. Chat-only (built-in tools disabled, single turn,
# stateless); caller-defined tools are dropped. Real token streaming. Set up the
# token once with `claude setup-token` (requires a subscription). All optional:
#   PROXY_CLAUDE_BIN          path to the `claude` CLI (default: "claude" on PATH)
#   PROXY_CLAUDE_OAUTH_TOKEN  long-lived token from `claude setup-token` (injected as CLAUDE_CODE_OAUTH_TOKEN)
#   PROXY_CLAUDE_MODEL        global model override (default: the alias's model if a Claude name, else CLI default)
#   PROXY_CLAUDE_CONCURRENCY  max simultaneous claude runs before queueing (default 2, max 16)
#   PROXY_CLAUDE_TIMEOUT      per-call timeout in seconds (default 180)
#   PROXY_CLAUDE_WORKDIR      child HOME/cwd when a token is set (default <temp>/connect-ai-proxy-claude)
#   PROXY_CLAUDE_SAFE_MODE    pass --safe-mode to ignore ambient CLAUDE.md/skills (default 0; needs claude >= 2.1.169)
#   PROXY_CLAUDE_SYSTEM_PROMPT  replace the CLI's default system prompt (default: keep it)
#   PROXY_CLAUDE_EXTRA_ARGS   extra flags appended to every `claude` invocation
#   PROXY_CLAUDE_AUTO_UPDATE  1 = let update-linux.sh refresh the claude CLI; default 0 (pinned)
# The backend always runs with DISABLE_AUTOUPDATER=1 and with ANTHROPIC_BASE_URL/
# ANTHROPIC_AUTH_TOKEN/ANTHROPIC_API_KEY stripped, so it can never self-update or be
# pointed back at this proxy. When PROXY_CLAUDE_OAUTH_TOKEN is set the child HOME is
# isolated too; with no token the inherited HOME (subscription login) is used.
# PROXY_CLAUDE_OAUTH_TOKEN=sk-ant-oat...
#
# PROXY_CLAUDE_SETTINGS_SYNC: the proxy normally rewrites ~/.claude/settings.json to
# point Claude Code at itself (ExecStartPre `sync apply`). On a backend server that
# also serves a claude upstream, set this to 0 so it never self-points (which would
# loop). Default 1 (enabled).
# PROXY_CLAUDE_SETTINGS_SYNC=1
# Agy (Google Antigravity) upstream — used when a model's "Forwarded to" = Agy.
# Text-only (no tool calls / no native streaming). All optional:
#   PROXY_AGY_BIN   path to the agyj wrapper (default: sibling of the proxy binary, then PATH)
#   PROXY_AGY_CLI   path to the real agy CLI, e.g. /root/.local/bin/agy (default: agyj self-resolves)
#   PROXY_AGY_MODEL global model override sent to agy (default: agy's own configured model)
#   PROXY_AGY_CONCURRENCY  max simultaneous agy runs before queueing (default 2, max 16)
#   PROXY_AGY_TIMEOUT      per-call agy timeout in seconds (default 180)
#   PROXY_AGY_WARM_WORKERS persistent warm background workers (default 0, recommended 7)
#   PROXY_AGY_WORKER_MODEL model for warm workers (default gemini-3.8-flash-medium)
#   PROXY_AGY_QUEUE_TIMEOUT max seconds to wait in worker queue (default 15)
#   PROXY_CODEX_WARM_WORKERS standby worker slots for Codex/ChatGPT (default 7, 0 = unmanaged)
#   PROXY_CODEX_QUEUE_TIMEOUT max seconds to wait in Codex queue (default 30)
# PROXY_AGY_CLI=/root/.local/bin/agy
#   PROXY_AGY_RUN_AS  dedicated non-root Linux user every agy/agyj child is spawned as, instead of
#                     root (which the proxy itself runs as today). Why: as root, agy read
#                     /opt/connect-ai-proxy/.env and every clinic's past transcripts under
#                     /root/.gemini/antigravity-cli/brain, and the view-only agent's view_file is
#                     NOT confined to --add-dir (a direct run printed /etc/hostname on request).
#                     "" (unset/empty/off/none/root, case-insensitive) = disabled, today's
#                     behaviour. LINUX ONLY: on any other OS, or if the named user/its group
#                     memberships/home cannot be resolved, or if the resolved agy CLI or the agyj
#                     wrapper is not executable by that user (e.g. still points under /root), the
#                     proxy logs one FATAL line at startup and EVERY agy spawn then fails closed
#                     (an error, never a fallback to root) until fixed and restarted.
#                     Server setup this expects (run once, as root, BEFORE setting this and
#                     restarting the proxy):
#                       1. Create the user with its own home, e.g.:
#                            useradd --create-home --shell /usr/sbin/nologin agy
#                          (any username works; PROXY_AGY_RUN_AS must name it exactly)
#                       2. Install the real agy CLI at <home>/.local/bin/agy, OWNED BY THAT USER
#                          (PROXY_AGY_RUN_AS tries this path first when PROXY_AGY_CLI is unset —
#                          see below):
#                            mkdir -p /home/agy/.local/bin
#                            cp /root/.local/bin/agy /home/agy/.local/bin/agy
#                            chown -R agy:agy /home/agy/.local
#                          If PROXY_AGY_CLI is set explicitly instead, that path must ALSO be
#                          owned/permissioned so the new user can execute it — a path under /root
#                          (0700) fails the startup check by design; do not chmod /root itself.
#                       3. Copy the Antigravity login so the new user is already authenticated —
#                          copy root's whole antigravity-cli state directory, then re-own it:
#                            mkdir -p /home/agy/.gemini
#                            cp -a /root/.gemini/antigravity-cli /home/agy/.gemini/antigravity-cli
#                            chown -R agy:agy /home/agy/.gemini
#                          (this carries the OAuth/session state agy needs — without it the new
#                          user's agy runs would hit an interactive login prompt and hang)
#                       4. Set PROXY_AGY_RUN_AS=agy here and restart the proxy. Watch the startup
#                          log for "[agy] run-as: every agy/agyj child will run as user ..." — a
#                          "[agy] FATAL run-as config ..." line instead means it is NOT active and
#                          agy is refusing to run at all (not silently root) until fixed.
#                     What the proxy does NOT need done for it manually: agent definitions
#                     (~/.gemini/config/agents/...) are written directly under the new user's home
#                     and chowned automatically; each request's specific media/PDF-pages directory
#                     is chowned to the new user only when it is actually handed to that request
#                     (a sibling request's directory stays root-owned and invisible); the shared
#                     media/image roots are capped at traverse-without-list (0711) automatically.
#                     Rollback: clear PROXY_AGY_RUN_AS (or set it to "off") and restart — agy goes
#                     back to running as root immediately, no other change needed.
# PROXY_AGY_RUN_AS=agy
# Agy media attachments — agy reads images/audio/video/PDF/Office/archives sent
# with the request (inline base64 or remote URL). Optional per-attachment "md5"
# is verified for completeness. Needs ffmpeg + python doc libs on the host
# (provisioned by install/update). All optional:
#   PROXY_AGY_MEDIA            enable media handling (default 1; set 0 to disable)
#   PROXY_AGY_MEDIA_MODEL      default Antigravity model for media (default "Gemini 3.5 Flash (Low)")
#   PROXY_AGY_MEDIA_DIR        scratch dir for materialized files (default OS temp)
#   PROXY_AGY_MEDIA_TIMEOUT    per-call timeout in seconds for media requests (default 300)
#   PROXY_AGY_MEDIA_MAX_BYTES  max size per file, e.g. 1GB / 500MB (default 1GB)
#   PROXY_AGY_MEDIA_MAX_TOTAL  max materialized total per request (default 1GB)
#   PROXY_AGY_MEDIA_ALLOW_URLS allow downloading remote media URLs (default 1)
#   PROXY_AGY_MEDIA_RETENTION  seconds to keep decoded/extracted files for reuse (default 86400 = 24h)
#   PROXY_AGY_MEDIA_AGENT      agy agent used when every attachment is view-eligible — a directly
#                              viewable image (png/jpg/jpeg/webp/gif, agy's view_file is proven to open
#                              these) or a PDF Ghostscript successfully rendered (see PROXY_AGY_GS
#                              below) — instead of agy's default coding agent (~57 tools incl.
#                              run_command, run as root under --dangerously-skip-permissions). Default
#                              "connect-media-view" (self-installed; its only tool is view_file). Set to
#                              `off` (recognized synonyms, case-insensitive: empty/none/default/0/false)
#                              to fall back to today's default-agent behaviour for ALL media — the
#                              rollback switch, no rebuild needed. (Distinguishing "set to off/empty"
#                              from "not set at all" requires os.LookupEnv — see parseAgyMediaAgent in
#                              agy.go; the plain getenv() this file's other settings use cannot tell the
#                              two apart, which is why this one has its own recognized "off" spelling
#                              instead of relying on an empty value.) Attachments that are not
#                              view-eligible — audio, video, Office, archives, heic/bmp/tiff images, or a
#                              PDF Ghostscript could not render (missing/unconfigured gs, non-zero exit,
#                              timeout, zero pages — see PROXY_AGY_GS below) — always use the default
#                              coding agent regardless of this setting.
#   PROXY_AGY_GS               path to Ghostscript, used to render a PDF's pages to images so a PDF
#                              can also go through PROXY_AGY_MEDIA_AGENT (default: `gs` on PATH, else
#                              /usr/bin/gs if present; "" after resolution disables PDF rendering —
#                              PDFs then keep using the default coding agent). If rendering fails for
#                              any reason (gs missing, non-zero exit, timeout, zero pages), that one
#                              request falls back to the default coding agent; nothing else changes.
#   PROXY_AGY_PDF_MAX_PAGES    max pages rendered per PDF (default 10, clamped 1-50)
#   PROXY_AGY_PDF_DPI          page render resolution in DPI (default 150, clamped 72-300)
#   PROXY_AGY_PDF_TEXT_MAX     max chars of Ghostscript-extracted PDF text appended per request,
#                              across all PDFs (default 20000, clamped 0-200000)
# Agy image generation — agy renders an image to disk and the proxy serves it
# back as a link. OpenAI-compatible endpoint: POST /v1/images/generations and
# /openai/v1/images/generations ({prompt, size, n, model, response_format}); the
# returned url is /media/generated/<token>.<ext> (a capability URL). Also drivable
# from the control panel's Images page. All optional:
#   PROXY_AGY_IMAGE            enable image generation (default 1; set 0 to disable)
#   PROXY_AGY_IMAGE_MODEL      default Antigravity model for generation (default "Gemini 3.5 Flash (Low)")
#   PROXY_AGY_IMAGE_DIR        served root for generated images (default OS temp)
#   PROXY_AGY_IMAGE_RETENTION  seconds to keep generated images for reuse (default 86400 = 24h)
# VirusTotal malware scanning for media attachments (manage keys at /virustotal):
#   PROXY_VIRUSTOTAL_ENABLED     scan attachments before agy reads them (default 1)
#   PROXY_VIRUSTOTAL_KEYS        API keys, newline/comma separated (round-robin, 1h cooldown on error)
#   PROXY_VIRUSTOTAL_THRESHOLD   reject when >= N engines flag the file (default 1)
#   PROXY_VIRUSTOTAL_UPLOAD      upload files unknown to VT, else hash-only (default 1)
#   PROXY_VIRUSTOTAL_MAX_WAIT    max seconds to wait for an upload analysis (default 90)
#   PROXY_VIRUSTOTAL_FAIL_CLOSED reject when scanning is unavailable (default 0)
PROXY_VIRUSTOTAL_KEYS=
# ── Fast mode (OpenAI priority processing) ────────────────────────────────
# Fast mode buys "1.5x speed, increased usage" — it burns ChatGPT plan quota
# faster, so it ships OFF and is never enabled automatically.
#   PROXY_CODEX_FAST_MODE     off (default) | on. The master switch. While off,
#                             even an explicit per-request ask is refused and
#                             logged as fast_mode=suppressed(disabled).
#   CODEX_FAST_SERVICE_TIER   wire value. "priority" is the ONLY value the
#                             ChatGPT backend accepts — it 400s on "fast",
#                             despite OpenAI's 2026-07-30 rename. Don't change
#                             this without re-probing the backend.
#   PROXY_CODEX_FAST_MODELS   upstream models allowed to use it; defaults to the
#                             ones whose ChatGPT catalog advertises
#                             service_tiers=[priority]. "*" disables the gate.
#   PROXY_CLAUDE_FAST_MODELS  Anthropic aliases that ask for fast mode without
#                             sending `speed`. Empty by default (no model-name
#                             magic); "none" also means never.
# With the switch on, a request decides for itself: speed:"fast" opts in,
# speed:"standard" opts out, and silence inherits on. That is what Connect's
# per-AI-service and per-gateway-key toggles send.
PROXY_CODEX_FAST_MODE=off
CODEX_FAST_SERVICE_TIER=priority
PROXY_CODEX_FAST_MODELS=
PROXY_CLAUDE_FAST_MODELS=
CODEX_WEB_SEARCH_TOOL_TYPE=web_search
CODEX_REASONING_SUMMARY=auto
CODEX_SESSION_ISOLATION=1
CODEX_SESSION_FILE=.proxy.sessions.json
CODEX_PROMPT_CACHE_KEY=1
# Codex routes advertise a 200,000-token active context window so Claude Code
# compacts before hidden tool/subagent payloads reach the live backend.
# The proxy does not return assistant-message recovery text.
CODEX_UPSTREAM_HARD_TOKENS=200000
CODEX_UPSTREAM_BLOCK_AT_HARD=0
CLAUDE_TOOL_ACTIVITY_THINKING=1
# Optional Antigravity/Chrome bridge overrides. Defaults are auto-discovered.
# Set to 0 on servers or installs that should not add browser MCP tools.
ANTIGRAVITY_BROWSER_ENABLED=1
# ANTIGRAVITY_CHROME_PATH=/path/to/google-chrome-or-chrome.exe
# ANTIGRAVITY_EXTENSION_PATH=/path/to/Chrome/User Data/Default/Extensions/eeijfnjmjelapkebgockoeaadonbchdd/1.11.3_0
# ANTIGRAVITY_BROWSER_PROFILE=.antigravity-browser-profile
# Use "default" to attach only if Chrome already exposes a DevTools endpoint.
# Modern Chrome blocks launching DevTools control on the normal Default profile,
# so the bridge falls back to a controlled profile for visible Claude Code actions.
# Use "dedicated" to always launch the controlled profile. This is the
# recommended local-browser mode because it does not take over your normal tabs.
ANTIGRAVITY_BROWSER_MODE=dedicated
ANTIGRAVITY_BROWSER_PRELAUNCH_WITH_PROXY=0
ANTIGRAVITY_BROWSER_DEBUG_PORT=9233
# Optional: override where browser_screenshot saves PNG files.
# By default it uses "<Claude Code launch directory>\Claude Code Screenshots".
# ANTIGRAVITY_SCREENSHOT_DIR=/path/to/Claude Code Screenshots
# Only for older/custom Chrome builds where Default-profile DevTools still works.
ANTIGRAVITY_BROWSER_FORCE_DEFAULT_CDP=0
# When forced Default CDP is enabled and Chrome is only background/proxy windows,
# this permits a safe relaunch with the DevTools port.
ANTIGRAVITY_BROWSER_SAFE_DEFAULT_RELAUNCH=1
# Optional: low, medium, or high if your Codex backend accepts it.
# CODEX_WEB_SEARCH_CONTEXT_SIZE=medium
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-7[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES=effort,xhigh_effort,max_effort,thinking,adaptive_thinking,interleaved_thinking
ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES=effort,max_effort,thinking,adaptive_thinking,interleaved_thinking
ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES=thinking
CLAUDE_CODE_EFFORT_LEVEL=xhigh
OPENAI_REASONING_EFFORT=xhigh
API_TIMEOUT_MS=3000000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
PROXY_API_KEY=sk-local-proxy-token
PROXY_HOST=127.0.0.1
PROXY_PORT=4000
# Optional public HTTPS/domain URL shown to clients and API docs. Leave blank for local-only installs.
# Standard ports are omitted, for example https://proxy.example.com instead of https://proxy.example.com:443.
PROXY_PUBLIC_URL=
PROXY_DB_PATH=.proxy.db
PROXY_AUTO_UPDATE=0
PROXY_UPDATE_REPO_DIR=
PROXY_UPDATE_BRANCH=main
PROXY_UPDATE_VERSION_URL=https://raw.githubusercontent.com/xMed-Jordan/claude-code-proxy/main/VERSION
PROXY_UPDATE_STATUS_FILE=.proxy.update.json
PROXY_DASHBOARD_FULL_SYSTEM_UPDATE=1
# Admin panel login. Leave ADMIN_PASSWORD_HASH empty to use the first-run setup screen.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Local client base URLs after startup:
# Anthropic-compatible: http://127.0.0.1:${PROXY_PORT}/anthropic
# OpenAI-compatible: http://127.0.0.1:${PROXY_PORT}/openai/v1
# Server HTTPS installs show PROXY_PUBLIC_URL in the dashboard, docs, OpenAPI, and Postman exports.
# Optional custom session headers accepted by both schemas:
# X-Proxy-Session-Id, X-Codex-Session-Id, X-OpenAI-Session-Id, X-Session-Id
